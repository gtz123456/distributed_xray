# ==============================================================================
# Distributed Xray - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' in the same directory and customize the values.
# All services call utils.LoadEnv() which reads the '.env' file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Service Port Configurations
# ------------------------------------------------------------------------------
# Registry Service listening port
Registry_Port=8000

# Log Service listening port
Log_Port=8001

# Node Service listening port
Node_Port=8002

# Web Service HTTP router listening port
Web_Port=8003

# Gin web server internal port for backend routing/APIs
GIN_PORT=8004

# Shell utility testing service port
Shell_Port=8005

# Payment Service listening port
Payment_Port=8006

# ------------------------------------------------------------------------------
# 2. Service Discovery & Networking
# ------------------------------------------------------------------------------
# The IP or host address of the Registry Service (e.g. regservice, 127.0.0.1, 172.17.0.2)
# Required by nodeservice, webservice, logservice, and registry client libraries.
Registry_IP=127.0.0.1

# The external domain or address of the Web Service (e.g., localhost:8004 or vpn.example.com)
# Used to construct registration/email verification links.
Web_Host=localhost:8004

# ------------------------------------------------------------------------------
# 3. Database Configurations
# ------------------------------------------------------------------------------
# DB connection DSN (base path without database name; e.g. root:password@tcp(mysql:3306))
# The application automatically appends the "/vpn..." suffix to this base path.
DB=root:password@tcp(127.0.0.1:3306)

# Database host IP (defined in utils but not actively used in core DB setup)
dbhost=127.0.0.1

# Root password for local MySQL container setups (if using docker-compose/K8s defaults)
MYSQL_ROOT_PASSWORD=password

# ------------------------------------------------------------------------------
# 4. Security & Cryptography Keys
# ------------------------------------------------------------------------------
# JWT sign key for encoding and decoding authorization web tokens (use a random string)
SECRET=your_jwt_secret_key_here

# Upper-case Registration Key for admin authentication paths (AdminAuth middleware)
REGKEY=your_admin_registration_key_here

# Lower-case Registration Key for inter-service authentication (nodes, payments, registry)
regkey=your_interservice_registration_key_here

# Xray Reality Private Key (used by nodeservice to configure the xray server inbound)
REALITY_PRIKEY=mNoGzlLbIVdKM0ZJY4sVZ8IOnFhwhdpcIYWBDQ_xQiw

# Xray Reality Public Key (used by webservice to distribute connection details to users)
REALITY_PUBKEY=pus2DL_XaiCBK05ddIynVtkYb75EjBm0vyCoZsUi2yw

# ------------------------------------------------------------------------------
# 5. Email & SMTP Configurations (SMTP Verification Settings)
# ------------------------------------------------------------------------------
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_app_password
FROM_ADDR=noreply@example.com
FROM_NAME="VPN Admin"

# ------------------------------------------------------------------------------
# 6. Node & Traffic Allocation Settings
# ------------------------------------------------------------------------------
# Custom description metadata displayed for the node (e.g. "US California Node")
Node_Description="Default Node Service"

# The file path of the xray binary executable
XRAY_PATH=./app/bin/xray

# Monthly bandwidth traffic allocation limit per node in Gigabytes (default: 10)
TRAFFIC_LIMIT_GB=10

# Day of the month on which traffic usage cycle resets (default: 1)
CYCLE_RESET_DAY=1

# ------------------------------------------------------------------------------
# 7. Payment API Configurations
# ------------------------------------------------------------------------------
# API Token for querying Transactions from the TronGrid API
TRONGRID_API_KEY=your_trongrid_api_key_here
